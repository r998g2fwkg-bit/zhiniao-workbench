      <button class="sec-tab" data-sec="aep"><svg class="tab-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M8.5 9l1.2 1.2L12.5 7.5"/><path d="M8.5 14l1.2 1.2L12.5 12.5"/><path d="M14.5 9h2.5"/><path d="M14.5 14h2.5"/></svg>AEP周任务<span class="tab-badge" data-badge="aep"></span></button>
      <button class="sec-tab" data-sec="exam"><svg class="tab-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><rect x="7.5" y="8" width="9" height="8" rx="1.5"/><path d="M7.5 11h9"/><path d="M10 6.5v2"/><path d="M14 6.5v2"/></svg>月考模式<span class="tab-badge" data-badge="exam"></span></button>
      <button class="sec-tab" data-sec="hours"><svg class="tab-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>课时追踪<span class="tab-badge" data-badge="hours"></span></button>
    </div>
    <div class="search-wrap">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="搜索主题、问题、答案或关键词…" autocomplete="off" aria-label="搜索">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      </div>
      <div class="filter-bar">
        <div class="filter-group">
          <div class="filters" id="sheetFilters"></div>
          <div class="filters" id="catFilters"></div>
        </div>
      </div>
    </div>
    </div>

    <section class="overview">
      <div class="ov-stats" id="stats"></div>
      <div class="ov-chart">
        <div class="donut-wrap">
          <svg width="132" height="132" viewBox="0 0 132 132" id="donut"></svg>
          <div class="donut-center"><span class="num" id="donutNum">0</span><span class="label">Ai Coach 条目</span></div>
        </div>
        <div class="donut-legend" id="donutLegend"></div>
      </div>
    </section>
    <section class="kw-section">
      <h3><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h10l6 6-8 8-8-8V4z"/><circle cx="9" cy="9" r="1.5" fill="currentColor"/></svg>高频关键词</h3>
      <p class="speech-desc">点击关键词快速筛选相关 Ai Coach，字号越大出现频率越高。</p>
      <div id="kwCloud" class="kw-cloud"></div>
    </section>

    <div class="work-toolbar">
      <div class="wt-left">
        <h2><span id="sectionTitle">Ai Coach</span> <span class="count" id="resultCount"></span></h2>
      </div>
      <div class="right">
        <div class="seg">
          <button class="seg-btn active" id="btnViewGrid"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>网格</button>
          <button class="seg-btn" id="btnViewBoard"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="6" height="18" rx="2"/><rect x="14" y="3" width="6" height="18" rx="2"/></svg>看板</button>
        </div>
        <button class="btn" id="btnGroupToggle"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3L2 8l10 5 10-5-10-5z"/><path d="M2 13l10 5 10-5"/><path d="M2 18l10 5 10-5"/></svg><span>折叠全部</span></button>
      </div>
    </div>
    <div id="cardList" class="grid"></div>
    <section class="exam-wrap" id="examWrap" style="display:none">
      <div class="exam-import" id="examImport"></div>
      <div id="examBugGuide"></div>
      <div class="exam-summary" id="examSummary"></div>
      <div class="exam-hitlog" id="examHitLog"></div>
      <div class="exam-hitlog admin-only" id="examCoverage"></div>
      <div id="examListWrap"></div>
      <div id="examCards" style="display:none"><div class="grid list-view exam-grid" id="examGrid"></div></div>
    </section>
    <div id="salaryWrap" style="display:none">
      <div id="salaryMsg" class="salary-msg" style="display:none"></div>
      <div id="salaryBar" class="salary-bar" style="display:none">
        <span class="salary-bar-label" id="salaryBarLabel"></span>
        <button class="salary-refresh" id="btnSalaryRefresh" type="button" title="刷新计算器">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-.7 4"/><path d="M20 4v5h-5"/></svg>
          <span>刷新</span>
        </button>
      </div>
      <iframe id="salaryFrame" class="salary-frame" title="激励计算器" src="about:blank"></iframe>
    </div>
    <div id="hoursWrap" style="display:none">
      <iframe id="hoursFrame" class="hours-frame" title="课时追踪" src="about:blank"></iframe>
    </div>
    <section class="aep-wrap" id="aepWrap" style="display:none">
      <div class="aep-header">
        <div class="aep-week-nav">
          <button class="btn btn-sm aep-week-btn" id="aepPrevWeek" title="上一周">◀</button>
          <span class="aep-week-label" id="aepWeekLabel">Q4W8</span>
          <span class="aep-week-range" id="aepWeekRange">8月16日–8月22日</span>
          <button class="btn btn-sm aep-week-btn" id="aepNextWeek" title="下一周">▶</button>
          <button class="btn btn-sm aep-week-btn" id="aepThisWeek" title="回到本周">本周</button>
        </div>
        <a class="btn btn-primary btn-sm" id="aepDownload" href="" download target="_blank">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> 下载图片
        </a>
      </div>
      <div class="aep-pdf-area">
        <img id="aepPdfImg" class="aep-pdf-img" alt="AEP 周任务" src="">
      </div>
      <div class="aep-match-sections">
        <div class="aep-match-block">
          <h3 class="aep-match-title">📘 话术匹配 → Ai Coach</h3>
          <div class="aep-match-list" id="aepScriptList"></div>
        </div>
        <div class="aep-match-block">
          <h3 class="aep-match-title">🎬 演示匹配 → Ai Demo</h3>
          <div class="aep-match-list" id="aepDemoList"></div>
        </div>
      </div>
    </section>
  </main>
</div>

<div class="drawer-scrim" id="drawerScrim"></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle">
  <div class="drawer-head">
    <div class="drawer-title" id="drawerTitle"></div>
    <button class="btn btn-icon drawer-speech-toggle" id="drawerSpeechToggle" aria-label="暂停朗读" title="暂停朗读"><svg id="drawerSpeechToggleIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg></button>
    <button class="btn btn-icon drawer-close" id="drawerClose" aria-label="关闭详情"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg></button>
  </div>
  <div class="drawer-nav" id="drawerNav">
    <button class="btn btn-icon" id="drawerPrev" title="上一张 (←)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
    <span class="drawer-nav-pos" id="drawerNavPos"></span>
    <button class="btn btn-icon" id="drawerNext" title="下一张 (→)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
  </div>
  <div class="drawer-body" id="drawerBody"></div>
</aside>

<div class="modal-overlay" id="confirmModal">
  <div class="modal">
    <h3>确认重置？</h3>
    <p>这将清空本地修改，恢复为表格原始数据。建议先导出备份。</p>
    <div class="modal-actions">
      <button class="btn" id="btnCancelClear">取消</button>
      <button class="btn btn-primary" id="btnConfirmClear">确认重置</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="salaryConfirmModal">
  <div class="modal">
    <h3><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="6.3"/><path d="M9 9.5 12 11.5l3-2"/><path d="M12 11.5V15"/><path d="M10 12.8h4"/><path d="M9.3 14h5.4"/></svg>进入激励计算器</h3>
    <p>激励数据为敏感信息，仅本人可查看，确认进入？</p>
    <div class="modal-actions">
      <button class="btn" id="btnSalaryConfirmCancel" type="button">取消</button>
      <button class="btn btn-primary" id="btnSalaryConfirmOk" type="button">确认进入</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="salaryPinModal">
  <div class="modal">
    <h3 id="salaryPinTitle">输入访问 PIN</h3>
    <p id="salaryPinDesc">请输入你的访问 PIN（由管理员分发）以继续。</p>
    <div class="salary-pin-field">
      <label for="salaryPinInput" id="salaryPinLabel1">PIN</label>
      <input type="password" id="salaryPinInput" inputmode="numeric" autocomplete="off" maxlength="6" placeholder="4–6 位数字">
    </div>
    <div class="salary-pin-msg" id="salaryPinMsg"></div>
    <p class="salary-pin-hint" id="salaryPinHint">PIN 由管理员分发，换设备输已知码即可。</p>
    <div class="modal-actions">
      <button class="btn" id="btnSalaryPinCancel" type="button">取消</button>
      <button class="btn btn-primary" id="btnSalaryPinOk" type="button">确认</button>
    </div>
  </div>
</div>

<input type="file" class="import-input" id="importFile" accept="application/json">

<div class="toast" id="toast" role="status" aria-live="polite"><svg class="toast-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg><span class="toast-msg"></span></div>

<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="图片预览" style="display:none">
  <div class="lightbox-backdrop"></div>
  <button class="lightbox-close" aria-label="关闭预览"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg></button>
  <button class="lightbox-nav lightbox-prev" aria-label="上一张"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
  <img src="" alt="" class="lightbox-img">
  <button class="lightbox-nav lightbox-next" aria-label="下一张"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
  <div class="lightbox-caption"></div>
  <div class="lightbox-counter"></div>
  <div class="lightbox-editbar" id="lbEditbar">
    <button class="lb-edit-del" aria-label="删除此图" title="删除此图"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></button>
    <button class="lb-edit-mv lb-edit-left" aria-label="左移" title="左移"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>
    <button class="lb-edit-mv lb-edit-right" aria-label="右移" title="右移"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>
  </div>
</div>

<div class="cmdk" id="cmdk">
  <div class="cmdk-box">
    <div class="cmdk-inputwrap">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
      <input id="cmdkInput" placeholder="输入命令或搜索 Ai Coach，如「分期」…" autocomplete="off">
      <kbd>Esc</kbd>
    </div>
    <div class="cmdk-list" id="cmdkList"></div>
  </div>
</div>


<div class="modal-overlay" id="addModal">
  <div class="modal">
    <h3 id="addModalTitle">新增 Ai Coach</h3>
    <p class="speech-desc" id="addModalDesc">填好内容后点「生成烘焙草稿」复制，发给 AI 写进代码重新部署，全员刷新即见（纯静态，零成本）。</p>
    <input type="hidden" id="addEditingId">
    <div class="form-row" id="rowType">
      <label>类型</label>
      <div class="seg" id="addTypeSeg">
        <button type="button" class="seg-btn active" data-type="new">新建主题</button>
        <button type="button" class="seg-btn" data-type="follow">追问轮</button>
      </div>
    </div>
    <div class="form-row" id="rowTopic">
      <label>Ai Coach 名称</label>
      <input id="addTopic" placeholder="如：iPhone 以旧换新">
    </div>
    <div class="form-row" id="rowFollow" style="display:none">
      <label>所属主题</label>
      <select id="addFollowTopic"></select>
    </div>
    <div class="form-row" id="rowSheet">
      <label>工作表</label>
      <input id="addSheet" list="sheetList" placeholder="如：iPhone（可填新表）">
    </div>
    <div class="form-row" id="rowCat">
      <label>分类</label>
      <input id="addCat" placeholder="如：销售技巧">
    </div>
    <div class="form-row" id="rowTurn" style="display:none">
      <label>轮次</label>
      <input type="number" id="addTurn" min="1" step="1" value="1" style="max-width:120px">
    </div>
    <div class="form-row" id="rowIsFollow" style="display:none">
      <label><input type="checkbox" id="addIsFollow"> 这是追问轮</label>
    </div>
    <div class="form-row" id="addRoundsRow" style="display:none">
      <label>多轮问答 <span style="font-weight:400;color:var(--text3)">首轮为入口问题，后续为追问轮</span></label>
      <div id="addRounds" class="rounds-list"></div>
      <button class="btn" id="btnAddRound" type="button" style="margin-top:6px">+ 增加一轮</button>
    </div>
    <div class="form-row" id="rowQuestion">
      <label>顾客问题 <span class="req">*</span></label>
      <textarea id="addQuestion" rows="2" placeholder="顾客会怎么问…"></textarea>
    </div>
    <div class="form-row" id="rowAnswer">
      <label>店员回答 <span class="req">*</span></label>
      <textarea id="addAnswer" rows="4" placeholder="店员的标准应答…"></textarea>
    </div>
    <div class="form-row">
      <label>关键词</label>
      <input id="addKeywords" placeholder="用 / 分隔，如：分期/免息">
    </div>
    <textarea id="addDraft" class="np-draft" readonly hidden placeholder="生成的草稿将显示在这里"></textarea>
    <div class="np-tip" id="addTip"></div>
    <div class="modal-actions">
      <button class="btn" id="btnAddCancel">取消</button>
      <button class="btn btn-primary" id="btnAddSave">生成烘焙草稿</button>
    </div>
  </div>
</div>
<datalist id="sheetList"></datalist>

<div class="modal-overlay" id="editDemoModal">
  <div class="modal">
    <h3>编辑演示</h3>
    <p class="speech-desc">修改这条演示的名称、工作表或介绍，保存后立即生效（仅本机持久化，团队同步请发给我重新部署）。</p>
    <input type="hidden" id="editDemoId">
    <div class="form-row">
      <label>演示名称 <span class="req">*</span></label>
      <input id="editDemoTopic" placeholder="如：iPhone 以旧换新">
    </div>
    <div class="form-row">
      <label>工作表</label>
      <input id="editDemoSheet" list="sheetList" placeholder="如：iPhone演示系列">
    </div>
    <div class="form-row">
      <label>分类</label>
      <input id="editDemoCat" placeholder="如：iPhone">
    </div>
    <div class="form-row">
      <label>演示类型</label>
      <select id="editDemoType">
        <option value="图片">图片</option>
        <option value="话术">话术</option>
      </select>
    </div>
    <div class="form-row">
      <label>店员话术介绍</label>
      <textarea id="editDemoIntro" rows="8" placeholder="每两行一步：标题 + 正文；或以「数字、」开头编号"></textarea>
    </div>
    <div class="modal-actions">
      <button class="btn" id="btnEditDemoCancel">取消</button>
      <button class="btn btn-primary" id="btnEditDemoSave">保存</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="tplModal">
  <div class="modal">
    <h3>Ai Coach 模板导入</h3>
    <p class="speech-desc">粘贴标准话术模板，点击「应用」即可本地新增或修改整条 Ai Coach 条目，无需使用卡片内编辑。需要同步给团队时，把本模板（或「导出烘焙草稿」）发给我重新部署即可。</p>
    <div class="form-row" style="flex-direction:column;align-items:stretch;gap:8px">
      <label>模板内容</label>
      <textarea id="tplInput" rows="12" spellcheck="false" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;line-height:1.65;white-space:pre" placeholder="===Ai Coach===&#10;标识：工作表||话术名称&#10;状态：上架&#10;分类：分类名&#10;轮次：&#10;首轮｜问：顾客问题｜答：店员回答&#10;追问1｜问：追问问题｜答：追问回答&#10;==="></textarea>
      <details class="tpl-spec">
        <summary style="cursor:pointer;font-weight:600;color:var(--accent)">模板格式说明</summary>
        <p style="margin:8px 0 4px">每行一个字段，轮次用 <code>｜</code> 分隔「问/答」：</p>
        <ul style="margin:4px 0 0;padding-left:18px">
          <li><code>标识：工作表||话术名称</code> —— 必填，用于定位/新增话术</li>
          <li><code>状态：上架 / 草稿 / 下架</code> —— 默认上架</li>
          <li><code>分类：分类名</code> —— 可留空</li>
          <li><code>首轮｜问：…｜答：…</code> —— 第 1 轮（入口）</li>
          <li><code>追问1｜问：…｜答：…</code> ／ <code>追问2｜…</code> —— 后续追问轮</li>
        </ul>
        <p style="margin:8px 0 0">多条 Ai Coach 条目可连续书写，以 <code>===Ai Coach===</code> 分隔；修改已有话术时按「标识」匹配并更新对应轮次。</p>
      </details>
    </div>
    <div id="tplResult" class="tpl-result"></div>
    <div class="modal-actions">
      <button class="btn" id="btnTplCancel">取消</button>
      <button class="btn btn-primary" id="btnTplApply">应用</button>
    </div>
  </div>
</div>

<script>
window.__APP_DATA__ = __APP_DATA_JSON__;
</script>

<script>
const RAW_DATA = window.__APP_DATA__.RAW_DATA;
/* 显式维护的「新上架」清单：ID 列表，话术与演示通用；空数组表示无新上架 */
const NEWLY_ADDED = window.__APP_DATA__.NEWLY_ADDED||[];
/* Tab 新内容角标：已读 key 持久化（每个版块记录已查看过的新内容标识，进入后清零） */
const K_TABSEEN='wb_zhiniao_tabseen';

const K_DATA='wb_zhiniao_data';
const K_ALLOWED='wb_zhiniao_allowed', K_SESSION='wb_zhiniao_session'; const SEED_EMAILS = window.__APP_DATA__.SEED_EMAILS;
/* 授权校验：仅 SEED_EMAILS 中的邮箱可进入工作台 */
function isAllowed(email){ return (email||'').trim().toLowerCase() && SEED_EMAILS.indexOf((email||'').trim().toLowerCase())>=0; }
/* 团队级全局下架列表：sheet||topic，由 AI 维护；所有设备加载时强制下架，实现跨账号/设备同步 */
const GLOBAL_ARCHIVED = window.__APP_DATA__.GLOBAL_ARCHIVED;
const ADMIN_EMAIL = window.__APP_DATA__.ADMIN_EMAIL;
/* ---------- 薪资计算器：常量与权限（纯前端 iframe 内嵌，零后端、零 Key） ----------
   契约：计算器读 ?store=<门店名> 后锁定只显示该店；不带 ?store= 时显示全部门店（管理员自查）。
   因此：管理员进入不拼 ?store=，普通用户拼 ?store=<本店名>。 */
const SALARY_URL = window.__APP_DATA__.SALARY_URL;
/* 课时追踪：与激励计算器同理通过 iframe 内嵌；URL 可在 __APP_DATA__.HOURS_URL 覆盖，缺省回退相对路径 */
const HOURS_URL = window.__APP_DATA__.HOURS_URL || '课时追踪.html';
function hoursStoreFor(email){ return SALARY_STORE_MAP[(email||'').trim().toLowerCase()]; }
function canSeeHours(email){ return canSeeSalary(email); }
const K_NOTICE_READ='wb_zhiniao_notice_read';
/* 纯静态模式（2026-08-11 回退）：本数组为通知唯一权威数据源，强一致、刷新即见、零服务器成本。
   发布流程：管理员在弹窗填好内容 → 点「生成烘焙草稿」复制 → 发给 AI → AI 把条目追加进本数组并重新部署 → 全员刷新即见。
   已放弃后端化（云函数+云存储受免费版 3s 超时与 COS 覆盖写最终一致性限制，SQL 数据库免费共享集群不可重置密码需付费，均违反零成本底线）。 */
let NOTICES = window.__APP_DATA__.NOTICES;
const NOTICE_TTL_DAYS = 3;   // 通知时效：超过 3 天自动转历史（sticky 置顶除外）
function isNoticeActive(n){
  if(n && n.sticky) return true;
  var d = new Date((n?n.date:'')+'T00:00:00');
  if(isNaN(d.getTime())) return true;       // 无法解析日期则保守视为 active
  return (Date.now() - d.getTime()) <= NOTICE_TTL_DAYS*24*3600*1000;
}
function getActiveNotices(){ return NOTICES.filter(isNoticeActive); }
function getHistoryNotices(){ return NOTICES.filter(function(n){ return !isNoticeActive(n); }); }
/* ===== 通知配置（纯静态模式，2026-08-11）===== */
/* NOTICE_API_BASE 置空 → 通知系统退化为纯内嵌快照：syncNotices/setNoticeRead 直接跳过后端，NOTICES 常量为唯一数据源。 */
window.NOTICE_API_BASE='';
/* 发布令牌：纯静态模式下已不再使用后端，留空即可。 */
window.NOTICE_PUBLISH_TOKEN='';
/* 已授权但不展示薪资入口的账号（测试账户等） */
const SALARY_HIDDEN_EMAILS = window.__APP_DATA__.SALARY_HIDDEN_EMAILS;
/* 邮箱 → 门店映射（key 必须小写） */
const SALARY_STORE_MAP = window.__APP_DATA__.SALARY_STORE_MAP;
/* 邮箱 → 访问 PIN（由 Rik 在账户信息表维护、预分发；硬编码校验，不写 localStorage） */
const SALARY_PIN_MAP = window.__APP_DATA__.SALARY_PIN_MAP;
/** 返回该邮箱关联的门店名；未关联返回 undefined。 */
function salaryStoreFor(email){ return SALARY_STORE_MAP[(email||'').trim().toLowerCase()]; }
/** 返回该邮箱的硬编码访问 PIN；无关联返回 undefined。 */
function salaryPinFor(email){ return SALARY_PIN_MAP[(email||'').trim().toLowerCase()]; }
/** 是否可见薪资入口：已授权 且 不在隐藏名单内。isAllowed 为函数声明，已提升，此处调用安全。 */
function canSeeSalary(email){ return isAllowed(email) && SALARY_HIDDEN_EMAILS.indexOf((email||'').trim().toLowerCase())<0; }
/* 演示板块数据：店员话术介绍 + 演示（图片/文字步骤）。由 AI 从 Keynote/PPTX 解析烘焙进此常量，重部署即同步 */
const DEMO_DATA = window.__APP_DATA__.DEMO_DATA;
const K_DEMO_FAV='wb_zhiniao_demofav';
/* AEP周任务：每周 PDF 展示(高清PNG) + 话术/演示题库匹配。由 AI 从 PDF 提取+匹配后烘焙进此常量，重部署即同步。
   startDate = 该周起始日(ISO)，用于自动判定当前周 + 锁定向前翻页(▶在该周起始日前禁用) */
const AEP_WEEKLY = window.__APP_DATA__.AEP_WEEKLY;
/* 月考模式：本月考试安排（静态烘焙，每月月初由 Rik 更新）。items 每项 { name, date|dateText, kind, color? }；kind 可选 'coach'|'demo' 决定圆点色 */
const EXAM_SCHEDULE = window.__APP_DATA__.EXAM_SCHEDULE || [];
